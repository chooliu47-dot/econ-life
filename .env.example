# Econ Life — Local First
# Copy to .env.local, then restart npm run dev:
#   cp .env.example .env.local
#
# IMPORTANT: use NEXT_PUBLIC_ prefix so Gemini runs in the browser
# and can use your system/Clash proxy (required in mainland China).

# Google AI Studio → https://aistudio.google.com/apikey
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key
